# Public/non-secret configuration
NEXTPLAN_GITHUB_REPO=changxinjiresearch/LifeOS
NEXTPLAN_GITHUB_BRANCH=main
NEXTPLAN_STATE_PATH=state.json
NEXTPLAN_EVENT_DIR=events/inbox

# Secrets: set these ONLY in the hosting platform's secret/variable store.
# Never commit real values and never paste them into chat.
NEXTPLAN_GITHUB_TOKEN=SET_IN_HOST_SECRET_STORE

# Recommended for a private single-user endpoint when the client cannot send
# a custom Authorization header. Generate a long random value in the host.
NEXTPLAN_MCP_PATH_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Optional alternative if the MCP client supports Authorization: Bearer <token>.
NEXTPLAN_MCP_BEARER_TOKEN=

# Keep false/unset in production.
NEXTPLAN_ALLOW_INSECURE=false
