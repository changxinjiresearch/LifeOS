{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextplan.local/event.schema.json",
  "title": "NextPlan Conversation Event",
  "type": "object",
  "required": ["id", "at", "type"],
  "properties": {
    "id": {"type": "string", "minLength": 8},
    "at": {"type": "string", "format": "date-time"},
    "type": {
      "type": "string",
      "enum": [
        "event_only",
        "project_created",
        "project_updated",
        "project_status_changed",
        "project_deleted",
        "milestone_added",
        "milestone_status_changed",
        "task_created",
        "task_updated",
        "task_completed",
        "task_deleted",
        "deadline_set",
        "deadline_removed",
        "calendar_event_upserted",
        "calendar_event_removed",
        "note_added",
        "note_updated",
        "note_removed",
        "resource_added",
        "resource_updated",
        "resource_removed",
        "automation_rule_upserted",
        "automation_rule_removed",
        "automation_snapshot_refreshed"
      ]
    },
    "project_id": {"type": "string"},
    "milestone_id": {"type": "string"},
    "task_id": {"type": "string"},
    "status": {"enum": ["active", "waiting", "planned", "completed", "done", "blocked"]},
    "project_status": {"enum": ["active", "waiting", "planned", "completed", "done", "blocked"]},
    "next_action": {"type": "string"},
    "auto_advance": {"type": "boolean"},
    "summary": {"type": "string"},
    "source": {"type": "object", "additionalProperties": true},
    "project": {"type": "object"},
    "changes": {"type": "object"},
    "milestone": {"type": "object"},
    "task": {"type": "object"},
    "deadline": {"type": "object"},
    "deadline_id": {"type": "string"},
    "calendar_event": {"type": "object"},
    "calendar_event_id": {"type": "string"},
    "note": {"type": "object"},
    "note_id": {"type": "string"},
    "resource": {"type": "object"},
    "resource_id": {"type": "string"},
    "automation_rule": {"type": "object"},
    "automation_rule_id": {"type": "string"},
    "automation_snapshot": {"type": "object"}
  },
  "additionalProperties": true
}
