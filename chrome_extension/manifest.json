{
  "manifest_version": 3,
  "name": "NextPlan Sync",
  "version": "0.6.0",
  "description": "NextPlan Sync + opt-in Jarvis project action review and user-selected ChatGPT context bridge.",
  "permissions": [
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://lifeos-production-89ce.up.railway.app/*",
    "https://changxinjiresearch.github.io/*"
  ],
  "background": {
    "service_worker": "background_v041.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://changxinjiresearch.github.io/LifeOS-App/jarvis.html"
      ],
      "js": [
        "jarvis_page_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NextPlan Sync",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
