{
  "manifest_version": 3,
  "name": "NextPlan Sync",
  "version": "0.5.0",
  "description": "Thin ChatGPT-to-NextPlan bridge. Parsing and decision logic run in the NextPlan cloud backend.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://lifeos-production-89ce.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background_v041.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NextPlan Sync",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
